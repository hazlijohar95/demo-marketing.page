    "@fontsource/inter": "^5.3.0",
    "@paper-design/shaders-react": "0.0.80",
    "astro": "7.3.3",
    "emdash": "^0.38.0",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boxcompute",
  // No account_id or resource ids on purpose. A hardcoded account_id fails with
  // error 7003 for anyone deploying to a different account, and pinned D1/KV ids
  // fail the same way because those resources live in one account only — both
  // break forks and the Deploy to Cloudflare button. Wrangler resolves D1 and R2
  // by name and provisions anything missing, so a fork deploys untouched. Set
  // CLOUDFLARE_ACCOUNT_ID when a login has more than one account and the deploy
  // has to stay non-interactive.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boxcompute-cms",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "boxcompute-media",
    },
  ],
  // Astro sessions. Auto-provisioned per account; the data is transient, so a
  // fresh namespace only means signing back into the CMS.
  "kv_namespaces": [
    {
      "binding": "SESSION",
    },
  ],
  // Drives scheduled publishing and EmDash maintenance. Without it, a post
  // scheduled for later never goes live.
  "triggers": {
    "crons": ["* * * * *"],
  },
}

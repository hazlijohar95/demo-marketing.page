# Copy to .env and fill in. Never commit .env.

# Encrypts plugin secrets stored by the EmDash CMS.
# Generate with: bunx emdash secrets generate
# Losing this value makes already-stored plugin secrets unreadable.
EMDASH_ENCRYPTION_KEY=

# Only needed for `bun run deploy` when your Cloudflare login has more than one
# account, so wrangler does not have to ask which one. Not a secret.
# CLOUDFLARE_ACCOUNT_ID=

---
import "../styles.css"

interface Props {
  title?: string
}

const {
  title = "A workspace for every agent — BoxCompute",
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#161616" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161616" />
    <meta
      name="description"
      content="Isolated cloud Sandboxes grouped by persistent workspaces for AI agents to build, test, and explore."
    />
    <meta
      name="keywords"
      content="AI agent workspace, AI agent sandbox, secure agent work, autonomous agents, coding agents, persistent workspace"
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BoxCompute" />
    <meta property="og:title" content="A workspace for every agent — BoxCompute" />
    <meta
      property="og:description"
      content="Isolated Sandboxes for AI agents to build, test, and explore. Workspaces persist."
    />
    <meta property="og:image" content="/boxcompute-social-card.png" />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="480" />
    <meta property="og:image:alt" content="BoxCompute" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="A workspace for every agent — BoxCompute" />
    <meta
      name="twitter:description"
      content="Isolated Sandboxes that resume. Workspaces persist."
    />
    <meta name="twitter:image" content="/boxcompute-social-card.png" />
    <meta name="twitter:image:alt" content="BoxCompute" />
    <title>{title}</title>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "BoxCompute",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Cloud",
        "description": "Isolated cloud Sandboxes grouped by persistent workspaces for AI agents."
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <noscript>JavaScript enables the mobile navigation menu. You can also use the links in the footer.</noscript>
  </body>
</html>
